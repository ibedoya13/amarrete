---
import "../styles/editor.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Amarrete - personal",
  description = "Sitio personal con mi currículum e información personal.",
} = Astro.props;
---

<!doctype html>
<html lang="es" data-webtui-theme="catppuccin-mocha">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,700;1,400&display=swap"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <script is:inline>
      // Aplicar el tema guardado antes de pintar (evita parpadeo entre temas).
      try {
        var saved = localStorage.getItem("webtui-theme");
        if (saved === "catppuccin-mocha" || saved === "catppuccin-latte") {
          document.documentElement.dataset.webtuiTheme = saved;
        }
      } catch (e) {}
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  @layer base, utils, components;

  @import "@webtui/css/base.css";

  /* Utilities */
  @import "@webtui/css/utils/box.css";

  /* Components */
  @import "@webtui/css/components/typography.css";
  @import "@webtui/css/components/button.css";
  @import "@webtui/css/components/badge.css";
  @import "@webtui/css/components/separator.css";
  @import "@webtui/css/components/progress.css";
  @import "@webtui/css/components/accordion.css";
  @import "@webtui/css/components/table.css";
  @import "@webtui/css/components/pre.css";
  @import "@webtui/css/components/mark.css";

  /* Theme */
  @import "@webtui/theme-catppuccin";
</style>
