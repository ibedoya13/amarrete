---
// Open "file" panel in the editor: shows the content as code.
// `lines` is a list of already-highlighted HTML fragments (one per line).
import type { HighlightedLine, Language, SectionFile } from "../types";

interface Props {
  /** Section file name shown by this panel. */
  file: SectionFile;
  /** File language (reflected in the status bar). */
  language: Language;
  /** Already-highlighted lines, ready to inject as HTML. */
  lines: HighlightedLine[];
  /** If `true`, the panel starts visible. */
  active?: boolean;
}

const { file, language, lines, active = false } = Astro.props;
---

<article class="panel" data-panel={file} data-language={language} hidden={!active}>
  <div class="code">
    {lines.map((line) => <div class="line" set:html={line} />)}
  </div>
</article>
