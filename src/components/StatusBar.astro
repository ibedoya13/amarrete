---
// Barra de estado inferior del editor (footer).
---

<footer class="statusbar">
  <div class="statusbar__group">
    <span class="sb-item sb-branch">⎇ main</span>
    <span class="sb-item sb-ok">✓ 0</span>
    <span class="sb-item sb-warn">⚠ 0</span>
    <span class="sb-item" data-status-file>sobre-mi.ts</span>
  </div>
  <div class="statusbar__group">
    <span class="sb-item">Ln 1, Col 1</span>
    <span class="sb-item"><span data-status-lines>0</span> líneas</span>
    <span class="sb-item">UTF-8</span>
    <span class="sb-item">LF</span>
    <span class="sb-item" data-status-lang>TypeScript</span>
  </div>
</footer>
