---
// Lista de proyectos con badges y links.
interface Project {
  name: string;
  description: string;
  tech: string[];
  link?: string;
}

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

<ul marker-="round-tree">
  {
    projects.map((project) => (
      <li class="project">
        <strong>
          {project.link ? (
            <a href={project.link} target="_blank">
              {project.name}
            </a>
          ) : (
            project.name
          )}
        </strong>
        <p>{project.description}</p>
        <p class="tech">
          {project.tech.map((t) => (
            <span is-="badge" variant-="background2">
              {t}
            </span>
          ))}
        </p>
      </li>
    ))
  }
</ul>

<style>
  .project {
    margin-bottom: 1.5lh;
  }

  .project p {
    margin: 0.5lh 0;
  }

  .tech {
    display: flex;
    flex-wrap: wrap;
    gap: 1ch;
  }
</style>
