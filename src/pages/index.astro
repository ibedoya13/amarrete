        <CodePanel
          file="proyectos.ts"
          language="TypeScript"
          lines={proyectosSrc.map(highlightLine)}
        />
        <CodePanel
          file="contacto.ts"
          language="TypeScript"
          lines={contactoSrc.map(highlightLine)}
        />
      </main>

      <Explorer files={archivos} active={activo} />
    </div>

    <StatusBar />
  </div>

  <div class="mobile-notice">
    <div class="mobile-notice__content">
      <span class="mobile-notice__glyph" aria-hidden="true">🖥️</span>
      <p class="mobile-notice__title">amarrete</p>
      <p class="mobile-notice__text">
        Esta vista está optimizada para pantallas grandes. Accede desde una tableta o computadora
        para ver el contenido.
      </p>
    </div>
  </div>
</Layout>

<script>
  const panels = Array.from(document.querySelectorAll("[data-panel]"));
  const items = Array.from(document.querySelectorAll("[data-file]"));
  const fileEls = document.querySelectorAll("[data-status-file]");
  const langEls = document.querySelectorAll("[data-status-lang]");
  const linesEl = document.querySelector("[data-status-lines]");
  const DEFAULT = "sobre-mi.ts";

  function getFile() {
    const hash = decodeURIComponent(location.hash.slice(1));
    return items.some((i) => i.dataset.file === hash) ? hash : DEFAULT;
  }

  let current = null;

  function activate(file) {
    const panel = panels.find((p) => p.dataset.panel === file);
    if (!panel || file === current) return;

    const prev = current;
    current = file;

    const swap = () => {
      panels.forEach((p) => (p.hidden = p !== panel));
      items.forEach((i) => i.classList.toggle("is-active", i.dataset.file === file));
      fileEls.forEach((el) => (el.textContent = file));
      langEls.forEach((el) => (el.textContent = panel.dataset.language ?? ""));
      if (linesEl) linesEl.textContent = String(panel.querySelectorAll(".line").length);
    };

    if (prev !== null && document.startViewTransition) {
      document.startViewTransition(swap);
    } else {
      swap();
    }
  }

  items.forEach((item) => {
    item.addEventListener("click", () => {
      location.hash = item.dataset.file;
    });
  });

  window.addEventListener("hashchange", () => activate(getFile()));

  document.addEventListener("keydown", (e) => {
    if (e.key !== "ArrowUp" && e.key !== "ArrowDown") return;
    const idx = items.findIndex((i) => i.classList.contains("is-active"));
    const delta = e.key === "ArrowDown" ? 1 : -1;
    const next = items[(idx + delta + items.length) % items.length];
    location.hash = next.dataset.file;
    e.preventDefault();
  });

  activate(getFile());

  // ── Toggle de tema (Catppuccin Mocha ⇄ Latte) ──
  const THEME_KEY = "webtui-theme";
  const MOCHA = "catppuccin-mocha";
  const LATTE = "catppuccin-latte";
  const THEME_LABELS = { [MOCHA]: "Catppuccin Mocha", [LATTE]: "Catppuccin Latte" };

  const themeToggle = document.querySelector("[data-theme-toggle]");
  const themeLabel = document.querySelector("[data-theme-label]");

  function currentTheme() {
    return document.documentElement.dataset.webtuiTheme === LATTE ? LATTE : MOCHA;
  }

  function applyTheme(theme) {
    document.documentElement.dataset.webtuiTheme = theme;
    try {
      localStorage.setItem(THEME_KEY, theme);
    } catch (e) {}
    if (themeLabel) themeLabel.textContent = THEME_LABELS[theme];
  }

  // Sincroniza la etiqueta con el tema (el script inline del <head> ya lo aplicó).
  applyTheme(currentTheme());

  themeToggle?.addEventListener("click", () => {
    applyTheme(currentTheme() === MOCHA ? LATTE : MOCHA);
  });
</script>
