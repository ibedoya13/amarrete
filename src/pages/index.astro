// Líneas que ya llevan su propio HTML (p. ej. enlaces) empiezan con este
// prefijo para que el resaltador las deje intactas.
const HTML_SENTINEL = "\u0002HTML\u0002";

function linkLine(indent: string, key: string, url: string, external = true): HighlightedLine {
  const attrs = external ? ` target="_blank" rel="noopener noreferrer"` : "";
  return (
    HTML_SENTINEL +
    `${indent}<span class="tk-key">${key}</span><span class="tk-pn">:</span> ` +
    `<a class="tk-link" href="${url}"${attrs}>` +
    `<span class="tk-str">"${url.replace(/^mailto:/, "")}"</span></a><span class="tk-pn">,</span>`
  );
}

