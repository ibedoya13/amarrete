// ── Mini resaltador de sintaxis (TS-like) ──

function escapeHtml(s: string): string {
  return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
}

function highlightLine(line: string): string {
  const re =
    /(\/\/.*$)|("(?:[^"\n]*)")|(\b\d+\b)|(\b(?:export|const|interface|type)\b)|(\b(?:string|number|boolean|Puesto)\b(?:\[\])?)|([A-Za-z_$][\w$]*)(?=\s*:)|([{}[\]();,:=])/g;
  const cls = [null, "tk-com", "tk-str", "tk-num", "tk-kw", "tk-type", "tk-key", "tk-pn"];
  let out = "";
  let last = 0;
  let m: RegExpExecArray | null;
  while ((m = re.exec(line))) {
    out += escapeHtml(line.slice(last, m.index));
    const g = m.slice(1).findIndex((x) => x !== undefined) + 1;
    out += `<span class="${cls[g]}">${escapeHtml(m[0])}</span>`;
    last = m.index + m[0].length;
  }
  out += escapeHtml(line.slice(last));
  return out;
}

